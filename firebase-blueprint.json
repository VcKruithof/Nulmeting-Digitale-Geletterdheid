{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Geautoriseerde Cloudwise beheerder toegekend vanuit Firebase",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" },
        "grantedAt": { "type": "string" }
      },
      "required": ["email", "isActive"]
    },
    "Bestuur": {
      "title": "Bestuur",
      "description": "Onderwijsbestuur waaraan scholen gekoppeld zijn",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "contactEmail": { "type": "string" },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "School": {
      "title": "School",
      "description": "School organisatie inclusief de unieke schoolcode, bestuur en modules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "schoolCode": { "type": "string" },
        "city": { "type": "string" },
        "sector": { "type": "string" },
        "bestuurId": { "type": "string" },
        "bestuurName": { "type": "string" },
        "assignedModules": { "type": "array" },
        "deadline": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdByUser": { "type": "string" }
      },
      "required": ["id", "name", "schoolCode", "isActive"]
    },
    "ActivationCode": {
      "title": "ActivationCode",
      "description": "Kandidaat-activeringscode gekoppeld aan een school",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "schoolId": { "type": "string" },
        "bestuurId": { "type": "string" },
        "schoolName": { "type": "string" },
        "targetSector": { "type": "string" },
        "targetFunction": { "type": "string" },
        "isUsed": { "type": "boolean" }
      },
      "required": ["code", "schoolId", "schoolName"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profiel van een onderwijsprofessional gekoppeld aan een school",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolCode": { "type": "string" },
        "schoolName": { "type": "string" },
        "bestuurId": { "type": "string" },
        "targetSector": { "type": "string" },
        "isCloudwiseAdmin": { "type": "boolean" },
        "isActivated": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "TestProgress": {
      "title": "TestProgress",
      "description": "Tussentijdse voortgangsopslag genest onder het gebruikersprofiel",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "currentQuestionIndex": { "type": "number" },
        "answers": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "currentQuestionIndex"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Voltooide nulmeting digitale geletterdheid van een gebruiker gekoppeld aan een school",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolCode": { "type": "string" },
        "schoolName": { "type": "string" },
        "bestuurId": { "type": "string" },
        "targetSector": { "type": "string" },
        "overallScorePercentage": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "schoolId", "schoolCode", "overallScorePercentage"]
    },
    "QuestionOverride": {
      "title": "QuestionOverride",
      "description": "Aangepaste vraag of antwoordoptie vanuit het admin portaal",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "docKey": { "type": "string" },
        "questionText": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "docKey", "questionText"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Exclusieve beheerderslijst enkel vanuit Firebase toegekend"
    },
    "/besturen/{bestuurId}": {
      "schema": "Bestuur",
      "description": "Onderwijsbesturen gekoppeld aan scholen en uiterste toetsdatum (deadline)"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Geregistreerde scholen inclusief unieke schoolcode en toegewezen modules"
    },
    "/activationCodes/{code}": {
      "schema": "ActivationCode",
      "description": "Optionele activeringscodes per doelgroep met gekoppelde school en modules"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Gebruikersprofielen met gekoppelde school"
    },
    "/users/{userId}/testProgress/{progressId}": {
      "schema": "TestProgress",
      "description": "Tussentijdse voortgangsopslag per gebruiker gekoppeld aan het gebruikersprofiel"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Nulmeting scores voor individueel inzien en geaggregeerde Cloudwise schoolrapporten"
    },
    "/questionBank/{questionId}": {
      "schema": "QuestionOverride",
      "description": "Aangepaste vragen en antwoorden vanuit de vragenbank"
    }
  }
}
