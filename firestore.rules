rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role can only be assigned in Firebase.
    // Cloudwise Beheerder (v.kruithof@edu.cloudwise.nl / kruithof.v@gmail.com)
    function isCloudwiseAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'v.kruithof@edu.cloudwise.nl' ||
        request.auth.token.email == 'kruithof.v@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@.*cloudwise\\.nl$')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCloudwiseAdmin == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }

    // Scholen collectie (bevat direct de schoolnaam, unieke schoolcode, bestuur & modules)
    // Publiek leesbaar zodat leerkrachten hun schoolcode kunnen verifiëren na inloggen
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isCloudwiseAdmin();
    }

    // Gebruikersprofielen
    // Nieuwe gebruikers mogen zichzelf nooit een beheerdersrol toekennen
    match /users/{userId} {
      allow get: if isOwner(userId) || isCloudwiseAdmin();
      allow list: if isCloudwiseAdmin();
      allow create: if isOwner(userId) && (!('isCloudwiseAdmin' in request.resource.data) || request.resource.data.isCloudwiseAdmin == false);
      allow update: if (isOwner(userId) && (!('isCloudwiseAdmin' in request.resource.data) || request.resource.data.isCloudwiseAdmin == resource.data.isCloudwiseAdmin)) || isCloudwiseAdmin();
      allow delete: if isCloudwiseAdmin();

      // Tussentijdse voortgang gekoppeld aan de gebruiker (subcollectie onder users/{userId})
      match /testProgress/{progressId} {
        allow get, list: if (isOwner(userId) || isCloudwiseAdmin()) && isValidId(userId);
        allow create, update: if (isOwner(userId) || isCloudwiseAdmin())
          && isValidId(userId)
          && isValidId(progressId)
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId);
        allow delete: if (isOwner(userId) || isCloudwiseAdmin()) && isValidId(userId);
      }
    }

    // Nulmeting Assessment resultaten
    match /assessments/{assessmentId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isCloudwiseAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isCloudwiseAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isCloudwiseAdmin();
    }

    // Admins collectie (Read-only voor admins, nooit schrijfbaar via client)
    match /admins/{adminId} {
      allow read: if isCloudwiseAdmin();
      allow write: if false;
    }

    // Besturen collectie
    match /besturen/{bestuurId} {
      allow read: if true;
      allow write: if isCloudwiseAdmin() || isSignedIn();
    }

    // Vragenbank collectie (Aangepaste vragen en antwoorden, beheerd door Cloudwise)
    match /questionBank/{questionId} {
      allow read: if true;
      allow write: if isCloudwiseAdmin();
    }

    // Activeringscodes collectie (Schoolaccount & Kandidaten)
    match /activationCodes/{code} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isCloudwiseAdmin();
    }

    // Legacy opruiming (geen nieuwe writes toegestaan, enkel read/delete voor migratie & opschoning)
    match /schoolCodes/{code} {
      allow read: if true;
      allow delete: if isCloudwiseAdmin();
      allow create, update: if false;
    }

    match /testProgress/{userId} {
      allow read, delete: if isOwner(userId) || isCloudwiseAdmin();
      allow create, update: if false;
    }
  }
}
